{%- if town -%}
<div class="layout layout--col">
  <div class="map stretch w--full" data-downstream-map data-polyline="{{ polyline | escape }}">
    {% render "ds_box", place: place, chain: chain, ui: ui, end_text: end_text, distance: distance, travel: travel, lang: ds_lang, units: ds_units, max_steps: 4, chain_lines: 2, box_width: "w--[92cqw]", town_size_long: "title--small lg:title", town_size: "lg:title--large", chain_size: "", end_size: "title--small lg:title", dist_size: "label--small lg:label--base" %}
  </div>
</div>
{%- else -%}
{% render "ds_error", lang: ds_lang, big: "" %}
{%- endif -%}
