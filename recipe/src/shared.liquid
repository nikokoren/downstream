{% comment %}
  Downstream: shared part, prepended to every view by TRMNL (D18–D21, docs/DESIGN_PHILOSOPHY.md).
  Every word comes from the payload (ui, end_text, distance, travel); the only exception is the
  error screen, which shows when the payload is missing (docs/TEXT_REQUIREMENTS.md, text B).
{% endcomment %}
{%- assign ds_lang = trmnl.plugin_settings.custom_fields_values.language | default: "en" -%}
{%- if ds_lang != "de" -%}{%- assign ds_lang = "en" -%}{%- endif -%}
{%- assign ds_units = trmnl.plugin_settings.custom_fields_values.units | default: "metric" -%}
{%- if ds_units != "imperial" -%}{%- assign ds_units = "metric" -%}{%- endif -%}
{%- assign ds_world = "no" -%}
{%- assign ds_world_value = trmnl.plugin_settings.custom_fields_values.world_map -%}
{%- if ds_world_value == true or ds_world_value == "true" or ds_world_value == "yes" -%}{%- assign ds_world = "yes" -%}{%- endif -%}
{%- assign ds_pairs = "no" -%}
{%- assign ds_pairs_value = trmnl.plugin_settings.custom_fields_values.watershed_pairs -%}
{%- if ds_pairs_value == true or ds_pairs_value == "true" or ds_pairs_value == "yes" -%}{%- assign ds_pairs = "yes" -%}{%- endif -%}
{%- assign ds_labels = "yes" -%}
{%- assign ds_labels_value = trmnl.plugin_settings.custom_fields_values.map_labels -%}
{%- if ds_labels_value == false or ds_labels_value == "false" or ds_labels_value == "no" -%}{%- assign ds_labels = "no" -%}{%- endif -%}
{% comment %} A paired packet still has a normal primary journey in smaller views or with comparison off. {% endcomment %}
{%- if routes.size == 2 and town == nil -%}
  {%- assign ds_primary = routes.first -%}
  {%- assign town = ds_primary.town -%}
  {%- assign place = ds_primary.place -%}
  {%- assign chain = ds_primary.chain -%}
  {%- assign end = ds_primary.end -%}
  {%- assign end_text = ds_primary.end_text -%}
  {%- assign distance = ds_primary.distance -%}
  {%- assign travel = ds_primary.travel -%}
  {%- assign polyline = ds_primary.polyline -%}
  {%- assign changes = ds_primary.changes -%}
{%- endif -%}

{% comment %} The river chain: all steps up to max_steps, else the first two, "+N more", the last two;
   never "+1 more", which takes as much room as the one name it hides. If that is still longer than
   chain_chars characters (shortened or not, from 4 steps), only the first and last step around
   "+N more" (Hibbing's Canadian names and Denver's five rivers overflowed two lines, 2026-10-01). The box puts ui.along before it
   and ui.and after it, before the endpoint line (author 2026-10-02: "… → Danube and / ends in the Black Sea"): one sentence, no arrow at the end (author, 2026-10-01). {% endcomment %}
{% template ds_chain %}
{%- assign ui_l = ui[lang] -%}
{%- assign n = chain.size -%}
{%- assign head = 2 -%}
{%- assign tail = 2 -%}
{%- assign force = false -%}
{%- for pass in (1..2) -%}
  {%- assign hidden = n | minus: head | minus: tail -%}
  {%- assign tail_start = n | minus: tail -%}
  {%- assign shorten = false -%}
  {%- if n > max_steps and hidden > 1 -%}{%- assign shorten = true -%}{%- endif -%}
  {%- if force and hidden > 1 -%}{%- assign shorten = true -%}{%- endif -%}
  {%- capture out -%}
    {%- assign sep = "" -%}
    {%- for step in chain -%}
      {%- assign i = forloop.index0 -%}
      {%- if shorten and i >= head and i < tail_start -%}
        {%- if i == head -%}{%- assign more = ui_l.more | replace: "{n}", hidden -%}{{ sep }}{{ more }}{%- assign sep = " → " -%}{%- endif -%}
      {%- else -%}
        {%- if step.name -%}{%- assign nm = step.name[lang] | default: step.name.local -%}{%- else -%}{%- assign nm = ui_l.a_stream -%}{%- endif -%}
        {{ sep }}{{ nm }}{%- assign sep = " → " -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- if head > 1 and n > 3 and out.size > chain_chars -%}
    {%- assign head = 1 -%}
    {%- assign tail = 1 -%}
    {%- assign force = true -%}
  {%- else -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
{{ out -}}
{% endtemplate %}

{% comment %} The text box over the map, one sentence: intro, town and country, path, endpoint, distance · travel time (D20). {% endcomment %}
{% template ds_box %}
<div class="absolute bottom--3 lg:bottom--6 {{ box_side | default: 'left--3' }} z--2 p--3 bg--canvas outline flex flex--col flex--left gap--xsmall {{ box_width }}" data-downstream-box>
  {%- comment -%} Long town names ("Kempston Hardwick, Vereinigtes Königreich") get one size smaller. {%- endcomment -%}
  {%- if place[lang].size > 32 -%}{%- assign ts = town_size_long -%}{%- else -%}{%- assign ts = town_size -%}{%- endif %}
  {%- if compact_town -%}
    {%- assign ds_words = place[lang] | replace: "-", " " | replace: "/", " " | split: " " -%}
    {%- assign ds_longest = 0 -%}
    {%- for ds_word in ds_words -%}{%- if ds_word.size > ds_longest -%}{%- assign ds_longest = ds_word.size -%}{%- endif -%}{%- endfor -%}
    {%- if place[lang].size > 32 or ds_longest > 16 -%}
      {%- assign ts = town_size_small -%}
    {%- elsif place[lang].size > 20 or ds_longest > 9 -%}
      {%- assign ts = town_size_long -%}
    {%- endif -%}
  {%- endif %}
  {%- comment -%} One sentence (author 2026-10-01): "A raindrop falling on / Munich, Germany / travels along … → / ends in the Black Sea". {%- endcomment %}
  <span class="w--full description {{ chain_size }}" data-clamp="1">{{ ui[lang].intro }}</span>
  <span class="w--full title {{ ts }}" data-clamp="{{ place_lines | default: 2 }}" data-downstream-place="{{ place[lang].size }}">{{ place[lang] }}</span>
  <span class="w--full description {{ chain_size }}" data-clamp="{{ chain_lines }}">{{ ui[lang].along }} {% render "ds_chain", chain: chain, ui: ui, lang: lang, max_steps: max_steps, chain_chars: chain_chars %}{% if ui[lang].and %} {{ ui[lang].and }}{% endif %}</span>
  <span class="w--full title {{ end_size }}" data-clamp="{{ end_lines | default: 2 }}">{{ end_text[lang] }}</span>
  <span class="w--full label {{ dist_size }}" data-clamp="{{ dist_lines | default: 1 }}">{{ distance[lang][units] }} · {{ travel[lang] | default: ui[lang].travel_unavailable }}</span>
</div>
{% endtemplate %}

{% comment %} Scoped route/label metadata. Escaped attributes work in native Liquid without a JSON filter. {% endcomment %}
{% template ds_route %}
<div class="hidden" data-downstream-route data-polyline="{{ polyline | escape }}" data-town="{{ town[lang] | default: town.en | escape }}">
  {%- for change in changes -%}
    {%- assign from = change.from[lang] | default: change.from.local -%}
    {%- assign to = change.to[lang] | default: change.to.local -%}
    {%- if from and to and change.at.size == 2 -%}
    <span data-downstream-change data-lon="{{ change.at[0] | escape }}" data-lat="{{ change.at[1] | escape }}" data-text="{{ from | escape }} → {{ to | escape }}"></span>
    {%- endif -%}
  {%- endfor -%}
</div>
{% endtemplate %}

{% comment %} Error screen (R18): the payload didn't arrive, so its words are missing too. {% endcomment %}
{% template ds_error %}
<div class="layout layout--col layout--center">
  {%- if lang == "de" -%}
  <span class="title {{ big }} text--center">Unser Regentropfen steckt in einer Pfütze fest.</span>
  <span class="description text--center">Er findet bald wieder heraus.</span>
  {%- else -%}
  <span class="title {{ big }} text--center">Our raindrop got lost in a puddle.</span>
  <span class="description text--center">It'll find its way back soon.</span>
  {%- endif -%}
</div>
{% endtemplate %}

