      if (!Number.isFinite(lat) || !Number.isFinite(lon) || Math.abs(lat) > 90 || Math.abs(lon) > 180) return null;
      var paint = { el: el }, inset = TRMNLPaint.px(12, paint), pad = TRMNLPaint.px(5, paint);
      var screen = TRMNLPaint.screen(el), large = !!(screen && screen.classList.contains("screen--lg"));
      var diameter = Math.min(TRMNLPaint.px(large ? 111 : 74, paint), el.clientWidth * 0.18);
      var size = diameter + 2 * pad;
      return { x: el.clientWidth - inset - size, y: el.clientHeight - inset - size,
        w: size, h: size, lat: lat, lon: lon, radius: diameter / 2 };
    }
    function drawGlobe(el) {
      var old = el.querySelector("[data-downstream-globe]");
      if (old) old.remove();
      var rect = worldRect(el);
      if (!rect) return null;
      var paint = { el: el }, ink = TRMNLPaint.textColor("default", paint);
      var paper = TRMNLPaint.semantic("canvas", paint).color;
      var cx = rect.x + rect.w / 2, cy = rect.y + rect.h / 2;
      var svg = svgEl("svg", { viewBox: "0 0 " + el.clientWidth + " " + el.clientHeight,
        class: "absolute top--0 left--0 w--full h--full z--2", "pointer-events": "none",
        "aria-hidden": "true", "data-downstream-globe": "" });
      var group = svgEl("g", { "data-world-rect": JSON.stringify(rect) });
      // The same outlined, centre-magnified locator as Ridgelines, with a circular paper halo.
      group.appendChild(svgEl("circle", { cx: cx, cy: cy, r: rect.w / 2, fill: paper }));
      var globe = DownstreamGlobe.project(WORLD_LAND, rect.lon, rect.lat, rect.radius);
      group.appendChild(svgEl("path", { d: globe.path || "", fill: "none", stroke: ink,
        "stroke-width": TRMNLPaint.px(0.75, paint), "stroke-linejoin": "round",
        transform: "translate(" + cx + " " + cy + ")", "data-world-land": "" }));
      group.appendChild(svgEl("circle", { cx: cx, cy: cy, r: rect.radius, fill: "none", stroke: ink,
        "stroke-width": TRMNLPaint.px(0.75, paint) }));
      var x = cx + globe.marker[0], y = cy + globe.marker[1];
      group.appendChild(svgEl("circle", { cx: x, cy: y, r: TRMNLPaint.px(3.5, paint), fill: paper }));
      group.appendChild(svgEl("circle", { cx: x, cy: y, r: TRMNLPaint.px(1.8, paint), fill: ink,
        "data-world-marker": "" }));
      svg.appendChild(group);
      el.appendChild(svg);
      return rect;
    }
    // The globe is self-contained and can still draw if the basemap's dependencies fail.
    function startGlobes() {
      var els = document.querySelectorAll("[data-downstream-map][data-world-lat][data-world-lon]");
      if (!els.length) return;
      var tries = 0;
      (function attempt() {
        if (!window.TRMNLPaint) {
          if (++tries <= 200) setTimeout(attempt, 50);
          return;
        }
        els.forEach(function (el) {
          function paint() { drawGlobe(el); }
          paint();
          if (window.ResizeObserver) new ResizeObserver(paint).observe(el);
          var screen = TRMNLPaint.screen(el);
          if (screen && window.MutationObserver) {
            new MutationObserver(paint).observe(screen, { attributes: true, attributeFilter: ["class"] });
          }
        });
      })();
    }

    function whenReady(cb) {
      var tries = 0;
      (function attempt() {
        if (window.TRMNLMaps && window.maplibregl && window.TRMNLPaint) return cb();
        if (++tries > 200) return;
        setTimeout(attempt, 50);
      })();
    }
    function build() {
      document.querySelectorAll("[data-downstream-map]").forEach(function (el, i) {
        if (el.getAttribute("data-downstream-built")) return;
        el.setAttribute("data-downstream-built", "1");
        if (!el.id) el.id = "downstream-map-" + i;
        var routes = DownstreamLabels.read(el);
        if (!routes.length) {
          var legacy = TRMNLMaps.decodePolyline(el.getAttribute("data-polyline") || "");
          if (legacy.length) routes = [{ coords: legacy, labels: [] }];
        }
        if (!routes.length) return;
        routes.forEach(function (r) { if (r.coords.length === 1) r.coords = [r.coords[0], r.coords[0]]; });
        var coords = routes.flatMap(function (r) { return r.coords; });
        var boxes = Array.from(el.querySelectorAll("[data-downstream-box]"));
        var box = boxes[0];
        TRMNLMaps.watch(el.id, function () {
          var opts = TRMNLMaps.options({ el: el.id, preset: "outline" });
          // World copies on, so a path near the 180th meridian (the Yukon to the Bering Sea) can
          // be framed beside the box; with them off MapLibre stops scrolling at the world's edge.
          // A map option, not the preset's style. Off-screen copies are never drawn elsewhere.
          opts.renderWorldCopies = true;
          var map = new maplibregl.Map(opts);
          el.__downstreamMap = map; // for the render check (recipe/tools/render-check.mjs)
          // Draw the path as soon as the style is ready, not on "load" (which waits for every
          // tile): the screenshot is taken when maps settle, and the path must be in it.
          function draw() {
            routes.forEach(function (r, j) {
              // Matching ink, widths and start markers; town names identify the journeys.
              var suffix = routes.length > 1 ? "-" + j : "";
              TRMNLMaps.route(map, r.coords, { el: el.id, id: "route" + suffix, i: 0, n: 1 });
              TRMNLMaps.dot(map, r.coords[0], { el: el.id, id: "start" + suffix });
              TRMNLMaps.dot(map, r.coords[r.coords.length - 1], { el: el.id, id: "end" + suffix, hollow: true });
            });
          }
          if (map.isStyleLoaded()) draw();
          else map.once("style.load", draw);
          // The whole path in view, clear of the text box (D19): frame it beside the box or above
          // it, whichever leaves the larger part of the map.
          function fitPath() {
            var globe = drawGlobe(el);
            var g = DownstreamLabels.fitGap(el);
            // Keep the route above the locator's halo as well as clear of the text box.
            var bottom = globe ? el.clientHeight - globe.y + g : g;
            var pads = [{ top: g, right: g, bottom: bottom, left: g }];
            if (boxes.length > 1) {
              var topPad = g;
              el.querySelectorAll("[data-downstream-obstacle]").forEach(function (n) {
                topPad = Math.max(topPad, n.offsetTop + n.offsetHeight + g);
              });
              pads = [{ top: topPad, right: g, bottom: Math.max.apply(null, boxes.map(function (b) {
                return el.clientHeight - b.offsetTop + g;
              })), left: g }];
            } else if (box) {
              var w = el.clientWidth, h = el.clientHeight;
              var right = box.offsetLeft + box.offsetWidth, top = box.offsetTop;
              var beside = { top: g, right: g, bottom: bottom, left: right + g };
              var above = { top: g, right: g, bottom: Math.max(h - top + g, bottom), left: g };
              pads = (w - right) * h >= w * top ? [beside, above] : [above, beside];
            }
            // At low zoom near the date line, try both sides and keep the framing with
            // the fewest points covered by either the text box or the locator.
            function coveredPoints() {
              var n = 0;
              coords.forEach(function (c) {
                var p = map.project(c);
                var underBox = boxes.some(function (b) { return p.x >= b.offsetLeft && p.x <= b.offsetLeft + b.offsetWidth &&
                  p.y >= b.offsetTop && p.y <= b.offsetTop + b.offsetHeight; });
                var underGlobe = globe && p.x >= globe.x && p.x <= globe.x + globe.w &&
                  p.y >= globe.y && p.y <= globe.y + globe.h;
                if (underBox || underGlobe) n++;
              });
              return n;
            }
            var best = null;
            for (var k = 0; k < pads.length; k++) {
              TRMNLMaps.fit(map, coords, { padding: pads[k], maxZoom: 12 });
              var n = coveredPoints();
              if (best === null || n < best.n) best = { n: n, pad: pads[k] };
              if (n === 0) break;
            }
            if (best.n > 0 || best.pad !== pads[pads.length - 1]) {
              TRMNLMaps.fit(map, coords, { padding: best.pad, maxZoom: 12 });
            }
          }
          fitPath();
          // Let the Framework finish placing its native city labels on the same idle
          // event before giving the journeys/callouts priority over conflicting names.
          function label() { Promise.resolve().then(function () {
            if (!map._removed) DownstreamLabels.draw(map, el, routes);
          }); }
          map.on("idle", label);
          if (document.fonts) document.fonts.ready.then(function () { if (!map._removed) label(); });
          if ((box || worldRect(el)) && window.ResizeObserver) {
            var observer = new ResizeObserver(fitPath);
            observer.observe(el);
            boxes.forEach(function (b) { observer.observe(b); });
            map.once("remove", function () { observer.disconnect(); });
          }
          return map;
        });
      });
    }
    function start() { startGlobes(); whenReady(build); }
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", start);
    else start();
  })();
</script>
